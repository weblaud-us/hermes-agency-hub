# ---------------------------------------------------------------------------
# Hermes Agency Hub — copy to .env and fill in before the first `up`.
# .env is gitignored. Never commit real values.
# ---------------------------------------------------------------------------

# ---- Required -------------------------------------------------------------
# Admin key for every /api/v1 route, sent as the X-API-Key header.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Postgres password for the hub's own database.
POSTGRES_PASSWORD=

# ---- Hub ------------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
# Tenants are served at <subdomain>.<BASE_DOMAIN>. For local work, *.localhost
# resolves to 127.0.0.1 in most browsers and curl without any hosts-file edit.
BASE_DOMAIN=localhost
HUB_PUBLIC_URL=http://localhost:8080
# Where the admin API listens on the host. Loopback by default — the control
# plane provisions containers and hands out credentials; do not expose it
# without putting authentication in front of it.
HUB_BIND=127.0.0.1
NGINX_HTTP_PORT=80

POSTGRES_USER=hermes
POSTGRES_DB=hermes_hub

# ---- Docker access --------------------------------------------------------
# Group that owns /var/run/docker.sock, added to the hub's unprivileged user.
#   Docker Desktop (Windows/macOS): 0  — the socket is root:root
#   Linux VPS:                      stat -c '%g' /var/run/docker.sock
DOCKER_GID=0

# ---- Tenant storage -------------------------------------------------------
# Bind-mounted into the hub at this SAME path, so the paths the hub writes are
# the paths the Docker daemon resolves for tenant bind mounts.
DATA_ROOT=/srv/hermes-multi
# Only if the hub genuinely cannot see the tree at the host's own path. Leave
# empty for the supported setup above.
# DATA_ROOT_HOST=

# ---- Agent image ----------------------------------------------------------
# Several GB. Pre-pull before onboarding: docker pull nousresearch/hermes-agent:latest
CLIENT_IMAGE=nousresearch/hermes-agent:latest
# always | missing | never
CLIENT_IMAGE_PULL_POLICY=missing

# If that tag does not resolve, build from a local checkout instead:
#   docker build -t hermes-agent:local C:\Users\sakib\AppData\Local\hermes\hermes-agent
#   CLIENT_IMAGE=hermes-agent:local

# ---- Routing --------------------------------------------------------------
# Containerized nginx (the default, local and production).
NGINX_CONTROL_MODE=docker
NGINX_UPSTREAM_MODE=network
PROBE_MODE=network

# Host-installed nginx instead (requires running the hub OUTSIDE Docker — a
# containerized hub has no host systemd to talk to). Swap in this whole block:
#   NGINX_CONTROL_MODE=systemctl
#   NGINX_UPSTREAM_MODE=loopback     # a host nginx cannot resolve container names
#   PROBE_MODE=loopback
#   NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
#   NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
#   NGINX_SITE_SUFFIX=
#   NGINX_TEST_COMMAND=["nginx","-t"]
#   NGINX_RELOAD_COMMAND=["systemctl","reload","nginx"]

# ---- Tenant resource envelope ---------------------------------------------
# Hard caps applied to every tenant container.
# CLIENT_CPUS=1.0
# CLIENT_MEMORY=2g
# Tight: s6 supervises the gateway, the dashboard and logging, and the agent's
# browser tool spawns Chromium. Raise if the browser tool fails to launch.
# CLIENT_PIDS_LIMIT=200

# Host port ranges for published tenant services. Must not overlap.
# DASH_PORT_RANGE=[19000,19499]
# API_PORT_RANGE=[19500,19999]

# ---- Optional integrations ------------------------------------------------
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
