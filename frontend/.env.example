# Only for running the website outside Docker with `npm run dev`; in Docker these
# come from docker-compose.yml. Copy to .env.local. Every NEXT_PUBLIC_ value is compiled into the browser
# bundle, so ADMIN_API_KEY must never appear in this file. People sign in at /login.

# Server-side only: where this frontend's /hub-api and /portal-api routes forward
# requests. Browsers talk to this frontend, never to the hub, so the hub stays
# private and its address stays out of the bundle. With nothing set, /admin and
# /portal/<slug> render labelled sample data.
PORTAL_HUB_URL=http://localhost:8080

# Matches the hub's BASE_DOMAIN. Used for subdomain previews and the installer
# command; live tenant URLs always come from the hub itself.
NEXT_PUBLIC_BASE_DOMAIN=agents.agency.com

# Local only: "true" lets the sign-in page's demo role pills fill in the demo passwords
# (Ishtiaq, Sakib, Jubayed). Compiled into the browser bundle, so never set it on a server.
# NEXT_PUBLIC_DEMO_LOGINS=true

# Capacity shown on the "Active Tenant Containers" card. The hub does not report
# a slot limit, so this is set per deployment.
NEXT_PUBLIC_TENANT_SLOTS=20
