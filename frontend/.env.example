# Only for running the website outside Docker with `npm run dev`; in Docker these
# come from docker-compose.yml. Copy to .env.local. Every NEXT_PUBLIC_ value is compiled into the browser
# bundle, so ADMIN_API_KEY must never appear in this file. Operators paste the
# key into the console's "Connect hub" dialog instead; it stays in that browser
# tab's sessionStorage.

# Hub base URL, no trailing slash. Leave empty to run the console on mock
# telemetry. The hub's CORS_ORIGINS must include this frontend's origin.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server-side only: where this frontend's /portal-api route forwards client portal
# requests. Client browsers talk to this frontend, never to the hub, so the hub
# stays private and its address stays out of the portal's bundle. Falls back to
# NEXT_PUBLIC_API_URL. With neither set, /portal/<slug> renders labelled sample data.
PORTAL_HUB_URL=http://localhost:8080

# Matches the hub's BASE_DOMAIN. Used for subdomain previews and the installer
# command; live tenant URLs always come from the hub itself.
NEXT_PUBLIC_BASE_DOMAIN=agents.agency.com

# Capacity shown on the "Active Tenant Containers" card. The hub does not report
# a slot limit, so this is set per deployment.
NEXT_PUBLIC_TENANT_SLOTS=20
