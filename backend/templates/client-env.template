# ---------------------------------------------------------------------------
# Hermes Agent environment for {{ company_name }} ({{ subdomain }})
#
# GENERATED BY THE AGENCY HUB — DO NOT EDIT BY HAND.
# Rewritten on every re-provision; manual edits are lost.
#
# This file is the authoritative configuration channel for the tenant. The
# agent loads $HERMES_HOME/.env with override=True, so values here WIN over
# anything passed via `docker run -e`. The hub therefore writes secrets here
# and deliberately does NOT duplicate them into the container environment —
# doing both triggers the image's "set in both ... the .env value wins"
# warning and makes credential rotation ambiguous.
#
# Mode 0600, owned by the container's `hermes` user.
# ---------------------------------------------------------------------------

# ---- Identity -------------------------------------------------------------
HERMES_HOME=/opt/data
# Remaps the image's internal `hermes` user so files written to the mounted
# tenant directory land with host-side ownership. Never start this image with
# `docker run --user`; it rejects an arbitrary UID outright.
HERMES_UID={{ client_uid }}
HERMES_GID={{ client_gid }}

# ---- Gateway --------------------------------------------------------------
# Without this the boot reconciler registers the gateway's supervised slot but
# leaves it DOWN on a fresh volume, so the tenant would come up with a running
# dashboard and a dead agent.
HERMES_GATEWAY_BOOTSTRAP_STATE=running

# ---- Web dashboard (port {{ dash_internal_port }}) -------------------------
HERMES_DASHBOARD=1
# Binds beyond loopback so the published port and the reverse proxy can reach
# it. A non-loopback bind makes the image's auth gate mandatory, which the
# basic-auth credentials below satisfy.
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT={{ dash_internal_port }}
HERMES_DASHBOARD_BASIC_AUTH_USERNAME={{ dashboard_username }}
# scrypt$n$r$p$<salt>$<dk>. The plaintext password was shown to the operator
# once at onboarding and is stored nowhere — not here, not in the hub database.
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH={{ dashboard_password_hash }}
# Signing key for stateless session tokens. Without a stable value every
# container restart silently invalidates all logins.
HERMES_DASHBOARD_BASIC_AUTH_SECRET={{ dashboard_secret }}

# ---- OpenAI-compatible API server (port {{ api_internal_port }}) ----------
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT={{ api_internal_port }}
# Bearer token for this tenant. The gateway refuses to start its API server
# if this is shorter than 16 characters.
API_SERVER_KEY={{ api_key }}

# ---- Model provider -------------------------------------------------------
OPENROUTER_API_KEY={{ openrouter_api_key }}

# ---- Agency metadata ------------------------------------------------------
# Informational: lets an operator inside the container tell which tenant and
# which control plane this instance belongs to.
HERMES_PUBLIC_URL={{ public_url }}
AGENCY_CLIENT_SLUG={{ slug }}
AGENCY_CLIENT_PLAN={{ plan }}
AGENCY_HUB_URL={{ hub_url }}
AGENCY_ENVIRONMENT={{ environment }}
